    <bpmn:serviceTask id="Activity_0ecumhp" name="Confirm Customer Order" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="8" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="data.smtpAction.from" />
          <zeebe:input target="data.smtpAction.to" />
          <zeebe:input target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input target="data.smtpAction.body" />
          <zeebe:input source="none" target="data.smtpAction.data_smtpAction_attachments_documentMode" />
          <zeebe:input source="=if data.smtpAction.data_smtpAction_attachments_documentMode = &#34;multiple&#34; then data.smtpAction.data_smtpAction_attachments_multiple_expression else if data.smtpAction.data_smtpAction_attachments_documentMode = &#34;single&#34; then (if data.smtpAction.data_smtpAction_attachments_single_documentSource = &#34;camunda&#34; then [data.smtpAction.data_smtpAction_attachments_single_camundaReference] else if data.smtpAction.data_smtpAction_attachments_single_documentSource = &#34;inline&#34; then [{ &#34;camunda.document.type&#34;: &#34;inline&#34;, content: data.smtpAction.data_smtpAction_attachments_single_inline_content, name: data.smtpAction.data_smtpAction_attachments_single_inline_fileName, contentType: data.smtpAction.data_smtpAction_attachments_single_inline_contentType }] else if data.smtpAction.data_smtpAction_attachments_single_documentSource = &#34;external&#34; then [{ &#34;camunda.document.type&#34;: &#34;external&#34;, url: data.smtpAction.data_smtpAction_attachments_single_external_url, name: data.smtpAction.data_smtpAction_attachments_single_external_fileName }] else null) else null" target="data.smtpAction.attachments" />
          <zeebe:input target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=587" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="TLS" target="data.smtpConfig.smtpCryptographicProtocol" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="8" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="resultVariable" />
          <zeebe:header key="resultExpression" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT30S" />
          <zeebe:header key="jobTimeout" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
